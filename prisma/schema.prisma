datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
  SUPERADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum MetalType {
  GOLD
  SILVER
  PLATINUM
}

model User {
  id              String          @id @default(uuid()) @db.Uuid
  name            String
  email           String          @unique
  phone           String?         @unique
  password        String
  role            Role            @default(USER)
  isActive        Boolean         @default(true)
  isDeleted       Boolean         @default(false)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  orders          Order[]
  carts           Cart[]
  wishlists       Wishlist[]
  userKitties     UserKitty[]
  reviews         Review[]
  sessions        Session[]
  designRequests  DesignRequest[]
  notifications   Notification[]
  grievances      Grievance[]

  @@index([email])
  @@index([phone])
  @@map("users")
}

model Admin {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  email       String    @unique
  password    String
  role        Role      @default(ADMIN)
  permissions Json?     @default("[]")
  isActive    Boolean   @default(true)
  lastLogin   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@map("admins")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  refreshToken String   @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Category {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @unique
  slug        String        @unique
  image       String?
  description String?
  isFeatured  Boolean       @default(false)
  isDeleted   Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  subcategories SubCategory[]
  products      Product[]

  @@index([slug])
  @@map("categories")
}

model SubCategory {
  id          String    @id @default(uuid()) @db.Uuid
  categoryId  String    @db.Uuid
  name        String
  slug        String    @unique
  image       String?
  description String?
  isDeleted   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category    Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products    Product[]


  @@index([categoryId])
  @@index([slug])
  @@map("subcategories")
}

model Metal {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @unique
  type         MetalType
  ratePerGram  Decimal   @db.Decimal(10, 2)
  purity       String
  updatedAt    DateTime  @updatedAt

  products     Product[]

  @@map("metals")
}

model PriceRule {
  id               String    @id @default(uuid()) @db.Uuid
  name             String
  makingChargeGram Decimal   @db.Decimal(10, 2)
  gstPercentage    Decimal   @default(3.00) @db.Decimal(5, 2)
  discountPercent  Decimal   @default(0.00) @db.Decimal(5, 2)
  updatedAt        DateTime  @updatedAt

  products         Product[]

  @@map("price_rules")
}

model Product {
  id             String       @id @default(uuid()) @db.Uuid
  title          String
  slug           String       @unique
  sku            String       @unique
  description    String       @db.Text
  images         String[]     @default([])
  weightGrams    Decimal      @db.Decimal(10, 3)
  stockQuantity  Int          @default(0)
  isFeatured     Boolean      @default(false)
  isPublished    Boolean      @default(true)
  isDeleted      Boolean      @default(false)

  categoryId     String?      @db.Uuid
  subcategoryId  String?      @db.Uuid
  metalId        String?      @db.Uuid
  priceRuleId    String?      @db.Uuid

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  category       Category?    @relation(fields: [categoryId], references: [id])
  subcategory    SubCategory? @relation(fields: [subcategoryId], references: [id])
  metal          Metal?       @relation(fields: [metalId], references: [id])
  priceRule      PriceRule?   @relation(fields: [priceRuleId], references: [id])
  reviews        Review[]
  cartItems      Cart[]
  wishlistItems  Wishlist[]

  @@index([slug])
  @@index([categoryId])
  @@index([subcategoryId])
  @@index([isPublished, isDeleted])
  @@index([categoryId, isPublished, isDeleted])
  @@index([subcategoryId, isPublished, isDeleted])
  @@map("products")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("carts")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  productId String   @db.Uuid
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wishlists")
}

model Order {
  id              String        @id @default(uuid()) @db.Uuid
  orderNumber     String        @unique
  userId          String        @db.Uuid
  totalAmount     Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0.00) @db.Decimal(12, 2)
  finalAmount     Decimal       @db.Decimal(12, 2)
  orderStatus     OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  items           Json
  shippingAddress Json
  razorpayOrderId String?       @unique
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user            User          @relation(fields: [userId], references: [id])
  transactions    Transaction[]

  @@index([userId])
  @@index([orderNumber])
  @@index([orderStatus])
  @@map("orders")
}

model KittyPlan {
  id              String       @id @default(uuid()) @db.Uuid
  name            String
  totalMonths     Int          @default(11)
  monthlyAmount   Decimal      @db.Decimal(10, 2)
  bonusMonths     Decimal      @default(1.0) @db.Decimal(3, 1)
  metalType       MetalType
  description     String?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())

  subscriptions   UserKitty[]

  @@map("kitty_plans")
}

model UserKitty {
  id               String       @id @default(uuid()) @db.Uuid
  userId           String       @db.Uuid
  planId           String       @db.Uuid
  paidMonths       Int          @default(0)
  totalAccumulated Decimal      @default(0.00) @db.Decimal(12, 2)
  status           String       @default("ACTIVE")
  nextDueDate      DateTime
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user             User         @relation(fields: [userId], references: [id])
  plan             KittyPlan    @relation(fields: [planId], references: [id])

  @@index([userId])
  @@index([planId])
  @@map("user_kitties")
}

model Transaction {
  id              String        @id @default(uuid()) @db.Uuid
  orderId         String?       @db.Uuid
  paymentId       String        @unique
  amount          Decimal       @db.Decimal(12, 2)
  currency        String        @default("INR")
  status          PaymentStatus
  gatewayResponse Json?
  createdAt       DateTime      @default(now())

  order           Order?        @relation(fields: [orderId], references: [id])

  @@map("transactions")
}

model Review {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  productId   String   @db.Uuid
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])

  @@index([productId])
  @@map("reviews")
}

model DesignRequest {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  description String
  images      String[] @default([])
  status      String   @default("PENDING")
  quoteAmount Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("design_requests")
}

model Banner {
  id          String   @id @default(uuid()) @db.Uuid
  title       String
  image       String
  link        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@map("banners")
}

model Contact {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  email       String
  subject     String
  message     String
  createdAt   DateTime @default(now())

  @@map("contacts")
}

model Grievance {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  subject     String
  description String
  status      String   @default("OPEN")
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@map("grievances")
}

model Notification {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @db.Uuid
  title       String
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model PromoCode {
  id              String   @id @default(uuid()) @db.Uuid
  code            String   @unique
  discountPercent Decimal  @db.Decimal(5, 2)
  maxDiscount     Decimal? @db.Decimal(10, 2)
  isActive        Boolean  @default(true)
  validUntil      DateTime
  createdAt       DateTime @default(now())

  @@map("promo_codes")
}
